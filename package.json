{
	"name": "ytkn",
	"version": "1.8.1",
	"description": "Turn YouTube videos, playlists, and channels into structured knowledge notes in your vault.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node scripts/build.mjs",
		"lint:full": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit -p tsconfig.eslint.json",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:coverage": "vitest --run --coverage",
		"verify": "npm run lint:full && npm run typecheck && npm run test:run && npm audit --audit-level=moderate && npm run build",
		"sync": "node sync.mjs",
		"sync:phone": "node scripts/sync-android.mjs phone",
		"sync:tablet": "node scripts/sync-android.mjs tablet",
		"sync:all": "npm run sync && npm run sync:phone && npm run sync:tablet",
		"release:prep": "npm version --no-git-tag-version",
		"release:check": "node scripts/verify-release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"youtube",
		"knowledge-notes",
		"summarizer",
		"ai",
		"transcript"
	],
	"author": "aawhb",
	"license": "GPL-3.0-or-later",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aawhb/ytkn.git"
	},
	"bugs": {
		"url": "https://github.com/aawhb/ytkn/issues"
	},
	"homepage": "https://github.com/aawhb/ytkn#readme",
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"esbuild": "^0.28.1",
		"eslint": "^10.7.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"fast-check": "^4.9.0",
		"jsdom": "^29.1.1",
		"obsidian": "^1.13.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"html-entities": "^2.6.0"
	}
}
