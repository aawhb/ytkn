# The absolute path to your Obsidian vault root.
# npm run sync copies files into .obsidian/plugins/ytkn automatically.
# Windows example: C:\Users\a\Documents\MyVault
# macOS/Linux example: /home/user/Documents/MyVault
OBSIDIAN_VAULT_PATH=

# Optional: plugin = obsidian plugin:reload id=ytkn, app = obsidian reload, none = copy only.
# Enable CLI in Obsidian Settings → General, then restart your terminal.
OBSIDIAN_SYNC_RELOAD=plugin

# Android device profiles. npm run sync:phone and sync:tablet copy files into
# .obsidian/plugins/ytkn. Use npm run sync:all to sync desktop, phone, and tablet.
# Android vault example: /storage/emulated/0/Documents/MyVault
OBSIDIAN_PHONE_VAULT_PATH=
OBSIDIAN_PHONE_DEVICE=
OBSIDIAN_PHONE_ADB_PATH=adb
OBSIDIAN_PHONE_ADB_SERVER_PORT=

OBSIDIAN_TABLET_VAULT_PATH=
OBSIDIAN_TABLET_DEVICE=
OBSIDIAN_TABLET_ADB_PATH=adb
OBSIDIAN_TABLET_ADB_SERVER_PORT=
